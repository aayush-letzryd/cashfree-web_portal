# ola-sync/.env — Copy this file to .env and fill in the real values.
# This file is committed; .env is git-ignored (never commit real secrets).

# ── Ola Portal credentials ────────────────────────────────────────────────────
OLA_PHONE_NUMBER=7483731338           # Mobile number registered on Ola Partner portal
OLA_EMAIL=ola@letzryd.com             # Email used for large-file fallback (Ola sends to this)

# ── OTP relay (SMSOLA Google Sheet) ──────────────────────────────────────────
OLA_SHEET_ID=1KrJ022-HfOBNnRVky7DBebCGm6jGcfk3OV3UqcHagIA
# ⚠️  TODO: Restrict this sheet to "specific people" — not "anyone with link"
#     OTPs are account-takeover credentials for the Ola partner account.

# ── Database — same Postgres as main.py ──────────────────────────────────────
# Option 1: full connection string (preferred on Render / cloud)
DATABASE_URL=postgresql://postgres:YOURPASSWORD@YOURHOST:5432/postgres

# Option 2: individual params (for local dev)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=postgres
# DB_PASS=YOURPASSWORD

# ── File paths (defaults are fine for most setups) ───────────────────────────
OLA_DOWNLOAD_DIR=./ola_downloads       # Where downloaded statements are saved
OLA_PROFILE_DIR=./ola_chrome_profile   # Persistent Chrome session dir

# ── Slack notifications (optional — leave blank to disable) ──────────────────
OLA_SLACK_WEBHOOK=
# Example: https://hooks.slack.com/services/T.../B.../xxxxx
